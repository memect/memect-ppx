# Docker 镜像与端口
PPX_IMAGE=ppx:local
PPX_PORT=9527
PPX_GPU_IMAGE=hub.wenyinhulian.cn/docparser/ppx-gpu:260702
PPX_GPU_PORT=9528
PPX_GPU_DEVICE_ID=0

# ── 镜像（不设置则用默认 ppx-xxx）
# APISERVER_IMAGE=registry.example.com/x2x-apiserver:1.0.0
# DEEPSEEK_IMAGE=registry.example.com/x2x-deepseek:1.0.0
# PADDLE_09B_IMAGE=registry.example.com/x2x-paddle-0.9b:1.0.0
# PADDLE_15B_IMAGE=registry.example.com/x2x-paddle-1.5b:1.0.0

# 宿主持久化目录
PPX_DATA_DIR_HOST=./data
PPX_LOG_DIR_HOST=./logs
PPX_CONF_DIR_HOST=./conf

# 构建选项：默认 CPU；需要 CUDA 镜像时改成 cuda
PPX_GPU=no
PPX_DOWNLOAD_MODELS=0
# 可选 Debian 镜像源，仅用于构建阶段；例如 https://mirrors.aliyun.com/debian
DEBIAN_MIRROR=
# 可选 PyPI 镜像源，仅用于构建阶段；例如 https://mirrors.aliyun.com/pypi/simple
PYPI_INDEX_URL=
# CUDA 镜像默认固定到 CUDA 12 兼容的 onnxruntime-gpu 版本
PPX_ONNXRUNTIME_GPU_VERSION=1.23.2

# 运行日志
PPX_LOG_LEVEL=INFO

# 强制部分/全部模型走 CPU：空值、all、ocr、layout、table、formula
PPX_CPU=

# 公式识别模型：formula-pp、formula-mfr、paddle、glm
PPX_FORMULA=formula-pp

# 可选外部 OCR/LLM 服务；宿主机服务可用 host.docker.internal
PPX_DEEPSEEK_URL=http://host.docker.internal:4000/v1
PPX_DEEPSEEK_SIZE=10
PPX_PADDLE_URL=http://host.docker.internal:4001/v1
PPX_PADDLE_SIZE=10
PPX_GLM_URL=http://host.docker.internal:4002/v1
PPX_GLM_SIZE=10
PPX_BAIDU_URL=http://host.docker.internal:4003/v1

# HuggingFace 下载端点；国内默认镜像，海外可改为 https://huggingface.co
HF_ENDPOINT=https://hf-mirror.com
